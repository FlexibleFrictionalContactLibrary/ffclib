@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Eigen3 3.4 NO_MODULE)
# A static ffclib hands HDF5 on to its users; a shared one carries it.
if(NOT @FFCLIB_SHARED@)
    find_dependency(HDF5 COMPONENTS C)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ffclibTargets.cmake")
check_required_components(ffclib)
